@using Libreria.DTOs.DataTransferObjects.DTOsUsuario
@model DTOLoginUsuario

<h2>Login</h2>

<form asp-action="Index" method="post">

    <div>
        <label>Email</label>
        <input asp-for="Email" />
    </div>

    <div>
        <label>Contraseña</label>
        <input asp-for="Contraseña" type="password" />
    </div>

    <button type="submit">Ingresar</button>

</form>
