@model ClienteWebApp.Models.LoginModel

@{
    ViewData["Title"] = "Login";
}

<h2>Iniciar sesion</h2>

<form asp-action="Login" asp-controller="Login" method="post">

    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" />
        <span asp-validation-for="Email" style="color:red"></span>
    </div>

    <div>
        <label asp-for="Contraseña"></label>
        <input asp-for="Contraseña" type="password" />
        <span asp-validation-for="Contraseña" style="color:red"></span>
    </div>

    <br />

    <button type="submit">Ingresar</button>

</form>

<!-- Errores generales (ej: login fallido) -->
<div asp-validation-summary="All" style="color:red"></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
