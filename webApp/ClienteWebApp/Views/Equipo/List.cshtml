@model IEnumerable<ClienteWebApp.Models.EquipoModel>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}
@{
    ViewData["Title"] = "Listado de Equipos";
}

<h2>Listado de Equipos</h2>

@if (!Model.Any())
{
    <p>No hay equipos registrados.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Tipo</th>
                <th>Cantidad Disponible</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var equipo in Model)
            {
                <tr>
                    <td>@equipo.EquipoId</td>
                    <td>@equipo.Marca</td>
                    <td>@equipo.Modelo</td>
                    <td>@equipo.TipoEquipo</td>
                    <td>@equipo.CantidadDisponible</td>

                    <td>
                        <a asp-controller="Equipo"
                           asp-action="Edit"
                           asp-route-id="@equipo.EquipoId"
                           class="btn btn-warning">
                            Editar
                        </a>

                        <a asp-controller="Equipo"
                           asp-action="Delete"
                           asp-route-id="@equipo.EquipoId"
                           class="btn btn-danger">
                            Eliminar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}